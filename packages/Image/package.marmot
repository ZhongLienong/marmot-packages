[package]
name = "Image"
version = "0.2.0"
description = "PNG, JPEG, and WebP image IO backed by Rust's image crate"
license = "MIT"
marmot_version = ">=1.0.0, <2.0.0"

[package.modules]
main = "Image.mmt"
exports = ["Image"]

[ffi]
enabled = true
library_name = "marmot_image"
abi_version = 1
thread_safe = true

[test]
dir = "test"
timeout_ms = 30000
